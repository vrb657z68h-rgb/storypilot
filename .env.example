# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# Öffentliche Adresse (mit https), z. B. https://storypilotapp.com
BASE_URL=https://storypilotapp.com
# Lange, zufällige Zeichenkette (z. B. mit: openssl rand -hex 32)
SESSION_SECRET=

# Meta-App (Instagram API mit Instagram-Login). Leer = Demo-Modus.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Stripe (Abo-Bezahlung). Leer = alles gratis freigeschaltet.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Gratis-Version
FREE_POSTS=10
FREE_ACCOUNTS=1
PRICE_LABEL=9,99 €

# Impressum
IMPRESSUM_NAME=
IMPRESSUM_ADRESSE=
IMPRESSUM_EMAIL=
IMPRESSUM_TELEFON=
IMPRESSUM_USTID=
